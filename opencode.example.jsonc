{
  // Example opencode config wiring up the opencode-localcat plugin.
  // Drop this (or merge relevant fields) into:
  //   - ~/.config/opencode/opencode.jsonc   (global)
  //   - .opencode/opencode.jsonc            (project)
  // Then run `opencode` and use /providers and /models to verify discovery.
  //
  // This plugin supports BOTH plugin APIs from one package.
  //
  // opencode V2 uses `plugins` (not `plugin`). Each entry is either a
  // package/path string or an object `{ package, options }`. A plugin is
  // referenced by package name ("opencode-localcat") or by a path/URL to its
  // built DIRECTORY (the dist/ directory, which contains index.js) — relative
  // ("./..."), absolute ("/..."), or file:// URL all work. A `file://` prefix
  // is NOT required.
  //
  // IMPORTANT: V2 requires a local path entry to be a plugin *directory*, not
  // a .js file — point at ".../opencode-localcat/dist", not
  // ".../opencode-localcat/dist/index.js". (A file path is only valid on V1.)
  //
  // opencode V1 (legacy) uses `plugin` (singular) with [spec, options] tuples
  // and the SAME options object. The equivalent V1 config would be:
  //
  //   {
  //     "plugin": [
  //       ["opencode-localcat", { "backends": { /* ...same options... */ } }]
  //     ]
  //   }

  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "file:///path/to/opencode-localcat/dist",
      "options": {
        // Per-backend config. Each backend supports:
        //   baseURL          (required when enabled)  e.g. "http://127.0.0.1:8080/v1"
        //   apiKey           (optional)                bearer token; "no-key-required" if omitted
        //   enabled          (optional, default true)  set false to skip a backend
        //   timeoutMs        (optional, default 5000)  per-request timeout for /v1/models and /props
        //   headers          (optional)                extra HTTP headers merged onto every request
        //   reasoningField   (optional, default "reasoning_content")
        //                                                  field in each streamed delta carrying reasoning
        //                                                  tokens — set it to the backend's actual key
        //                                                  (e.g. "reasoning", "thinking") so opencode
        //                                                  aggregates reasoning into one block
        //   includeNonChat   (optional, litellm only)  include embedding/completion models in the list
        //
        // Discovery runs once when opencode loads the plugin (V2 setup / V1 config).
        // Restart opencode to pick up newly added backend models.
        "backends": {
          "llama-cpp": {
            "enabled": true,
            "baseURL": "http://127.0.0.1:8080/v1",
            // llama.cpp ships with no API key by default; set this only if you started it with --api-key.
            "apiKey": "no-key-required",
            "timeoutMs": 5000
          },
          "litellm": {
            "enabled": true,
            "baseURL": "http://127.0.0.1:4000/v1",
            // LiteLLM proxy key (set via --master-key or config.yaml). Use a real key in production.
            "apiKey": "sk-litellm-proxy",
            "timeoutMs": 5000
          },
          "workbuddy-wild": {
            "enabled": true,
            "baseURL": "http://127.0.0.1:7863/v1",
            // WorkBuddy-Wild default token; change if you redefined it in the panel.
            "apiKey": "WorkBuddy2API",
            "timeoutMs": 5000
          }
        }
      }
    }
  ]
}
